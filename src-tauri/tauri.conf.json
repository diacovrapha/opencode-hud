{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "opencode HUD",
  "version": "0.2.0",
  "identifier": "com.diacovrapha.opencodehud",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "dashboard",
        "title": "opencode HUD",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "resizable": true
      },
      {
        "label": "widget",
        "title": "opencode HUD widget",
        "url": "index.html?view=widget#/widget",
        "width": 340,
        "height": 120,
        "minWidth": 340,
        "minHeight": 120,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "opencode HUD",
    "longDescription": "Painel de uso e custos do opencode."
  }
}